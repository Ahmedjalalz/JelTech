# ----------------------------------------------------
# Resend Email Configuration
# ----------------------------------------------------
RESEND_API_KEY=your_resend_api_key
RESEND_FROM=onboarding@resend.dev
RESEND_TO=contact@jeltech.net

# ----------------------------------------------------
# Supabase Configuration (Private server-side variables)
# (Supabase Dashboard -> Project Settings -> API)
# ----------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ----------------------------------------------------
# Careers Admin Account Credentials
# (/jeltech-careers-admin)
# ----------------------------------------------------
CAREERS_ADMIN_USERNAME=admin
CAREERS_ADMIN_PASSWORD=your_admin_password
CAREERS_ADMIN_EMAIL=admin@jeltech.net
